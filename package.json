{
  "name": "bionic-page",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Turn any web page into a bionic (fixation) reading page. Manifest V3 extension for Chrome and Firefox.",
  "scripts": {
    "build": "node build.mjs",
    "build:chrome": "node build.mjs chrome",
    "build:firefox": "node build.mjs firefox",
    "build:watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "icons": "node scripts/make-icons.mjs",
    "verify": "node scripts/verify-build.mjs",
    "e2e": "bun scripts/e2e.mjs",
    "bench": "bun scripts/bench.ts",
    "lint:firefox": "web-ext lint --source-dir dist/firefox",
    "package": "node scripts/package.mjs",
    "demo": "node scripts/build-demo.mjs",
    "og": "node scripts/make-og.mjs",
    "stamp": "node scripts/stamp-assets.mjs",
    "check-copy": "node scripts/check-copy.mjs",
    "e2e:site": "node scripts/e2e-site.mjs",
    "check-site": "node scripts/check-site.mjs",
    "site": "node scripts/build-demo.mjs && node scripts/make-og.mjs && node scripts/stamp-assets.mjs && node scripts/check-site.mjs && node scripts/check-copy.mjs"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/chrome": "^0.0.302",
    "esbuild": "^0.25.0",
    "linkedom": "^0.18.13",
    "typescript": "^5.7.2"
  }
}
